#!/usr/bin/env bash
# cfind — avvio rapido di calibrefind.
#
#   cfind                             # libreria grande di default
#   cfind -a gibson -t mancer         # criteri combinati
#   cfind -g "Letteratura Romanzi e Racconti"
#   cfind -l /altro/metadata.db ...   # libreria diversa
#   CALIBRE_LIBRARY=/percorso/metadata.db cfind
#
# Tutte le opzioni sono quelle di calibrefind.py (cfind --help).
set -euo pipefail

# percorso reale dello script, anche se invocato da un symlink
real="$(readlink -f -- "${BASH_SOURCE[0]}")"
dir="$(cd -- "$(dirname -- "$real")" && pwd)"

lib="${CALIBRE_LIBRARY:-$HOME/CalibreLibrary/metadata_big.db}"
[ -f "$lib" ] || lib="$HOME/CalibreLibrary/metadata.db"

py="$dir/.venv/bin/python"
[ -x "$py" ] || py="python3"

# -l di default va prima di "$@": un -l esplicito dell'utente lo sostituisce
exec "$py" "$dir/calibrefind.py" -l "$lib" "$@"
